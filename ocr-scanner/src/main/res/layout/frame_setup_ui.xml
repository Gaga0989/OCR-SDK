<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp">
        <RelativeLayout
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:visibility="gone"
                android:clickable="true"
                android:layout_alignParentRight="true"
                android:id="@+id/imgCloseDg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/close" />
            <RelativeLayout
                android:id="@+id/rlAlertDg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_marginTop="22dp"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioGroup
                        android:id="@+id/radioGroupFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:checkedButton="@+id/radioOption1">
                        <RadioButton
                            android:id="@+id/radioCenter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Screen center" />
                        <RadioButton
                            android:id="@+id/radioOpt1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Option 1" />
                        <RadioButton
                            android:id="@+id/radioOpt2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Option 2" />
                        <RadioButton
                            android:id="@+id/radioOpt3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Option 3" />
                        <RadioButton
                            android:id="@+id/radioManual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Setup Custom" />
                    </RadioGroup>

                    <LinearLayout
                        android:visibility="gone"
                        android:id="@+id/llManualForm"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:weightSum="4"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <EditText
                                android:id="@+id/txtTop1"
                                android:layout_margin="1dp"
                                android:background="@drawable/text_round_gray"
                                android:fontFamily="@font/dmsans_regular"
                                android:hint="Top1"
                                android:inputType="number"
                                android:textAlignment="center"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"/>
                            <EditText
                                android:id="@+id/txtTop2"
                                android:layout_margin="1dp"
                                android:background="@drawable/text_round_gray"
                                android:fontFamily="@font/dmsans_regular"
                                android:hint="Top2"
                                android:inputType="number"
                                android:textAlignment="center"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"/>
                            <EditText
                                android:id="@+id/txtBottom1"
                                android:layout_margin="1dp"
                                android:background="@drawable/text_round_gray"
                                android:fontFamily="@font/dmsans_regular"
                                android:hint="Bottom1"
                                android:inputType="number"
                                android:textAlignment="center"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"/>
                            <EditText
                                android:id="@+id/txtBottom2"
                                android:layout_margin="1dp"
                                android:background="@drawable/text_round_gray"
                                android:fontFamily="@font/dmsans_regular"
                                android:hint="Bottom2"
                                android:inputType="number"
                                android:textAlignment="center"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:weightSum="4"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <EditText
                                android:id="@+id/txtLeft1"
                                android:layout_margin="1dp"
                                android:background="@drawable/text_round_gray"
                                android:fontFamily="@font/dmsans_regular"
                                android:hint="Left1"
                                android:inputType="number"
                                android:textAlignment="center"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"/>
                            <EditText
                                android:id="@+id/txtLeft2"
                                android:layout_margin="1dp"
                                android:background="@drawable/text_round_gray"
                                android:fontFamily="@font/dmsans_regular"
                                android:hint="Left2"
                                android:inputType="number"
                                android:textAlignment="center"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"/>
                            <EditText
                                android:id="@+id/txtRight1"
                                android:layout_margin="1dp"
                                android:background="@drawable/text_round_gray"
                                android:fontFamily="@font/dmsans_regular"
                                android:hint="Right1"
                                android:inputType="number"
                                android:textAlignment="center"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"/>
                            <EditText
                                android:id="@+id/txtRight2"
                                android:layout_margin="1dp"
                                android:background="@drawable/text_round_gray"
                                android:fontFamily="@font/dmsans_regular"
                                android:hint="Right2"
                                android:inputType="number"
                                android:textAlignment="center"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvOkDg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/gradient_green_radius"
                        android:clickable="true"
                        android:fontFamily="@font/dmsans_regular"
                        android:text="OK"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="16dp" />
                </LinearLayout>
            </RelativeLayout>


        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>